# Copie para backend/.env e ajuste os valores.
AMBIENTE=desenvolvimento
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5432/projeto-aurora
JWT_SECRET=troque-isto
ACCESS_TOKEN_MINUTOS=30
REFRESH_TOKEN_DIAS=7
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_REMETENTE=nao-responda@projetoaurora.local
SMTP_USUARIO=
SMTP_SENHA=
SMTP_STARTTLS=false
# Para enviar de verdade pelo Gmail (em vez do Mailpit), use:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USUARIO=sua.conta@gmail.com
# SMTP_SENHA=senha-de-app-de-16-letras
# SMTP_REMETENTE=Projeto Aurora <sua.conta@gmail.com>
UPLOAD_DIR=./uploads
ARQUIVOS_URL_SEGREDO=troque-isto-tambem
MAX_TENTATIVAS_LOGIN=5
MINUTOS_BLOQUEIO=5
MINUTOS_VALIDADE_TOKEN_SENHA=30
MAX_PEDIDOS_RECUPERACAO_POR_HORA=3
HORAS_VALIDADE_TOKEN_EMAIL=24
MAX_REENVIOS_VERIFICACAO_POR_HORA=3
LIMITE_REQUISICOES_AUTH=30/minute
NOMINATIM_USER_AGENT=ProjetoAurora/1.0 (contato@exemplo.com)
ADMIN_EMAIL=admin@projetoaurora.local
ADMIN_SENHA=TroqueEstaSenha1
